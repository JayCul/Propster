# ---------------------------------------------------------------------------
# Propster environment. Copy to `.env` and fill in. Never commit `.env`.
# Every value here is read server-side only. Nothing is prefixed NEXT_PUBLIC_,
# so no secret can reach the browser bundle.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Postgres (Neon). Two URLs are required:
#   DATABASE_URL   the POOLED endpoint (host contains "-pooler"), used by the app
#   DIRECT_DB_URL  the DIRECT endpoint (same host without "-pooler"), used by
#                  `prisma db push`, because pgBouncer cannot run its DDL
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DB_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- CALL-E (phone verification) -------------------------------------------
# Get a key from https://docs.heycall-e.com/. When CALLE_API_KEY is set,
# Propster places REAL outbound verification calls through CALL-E.
# When it is absent, Propster falls back to the deterministic demo provider
# and every call is labelled as simulated in the UI.
CALLE_API_KEY=""
# https://api.heycall-e.com (production) or https://test-api.heycall-e.com
CALLE_BASE_URL="https://api.heycall-e.com"
# Public HTTPS URL of this app, used to build the CALL-E webhook callback.
# Leave empty in local dev and Propster polls the CALL-E API instead.
# Example: https://propster.example.com
PUBLIC_APP_URL=""
# Shared secret appended to the webhook path. CALL-E deliveries are unsigned,
# so the unguessable path segment is what authenticates the receiver.
CALLE_WEBHOOK_TOKEN=""

# --- Language model (requirement + transcript extraction) ------------------
# Optional. Without any key Propster uses its deterministic rule-based parser,
# which handles the demo phrasing and Nigerian rent notation but is less
# reliable on badly garbled speech recognition.
#
# "auto" (default) prefers Groq when a Groq key is present, Anthropic
# otherwise. Set explicitly to pin one.
LLM_PROVIDER="auto"

# Groq. OpenAI-compatible; run `npm run llm:check` to see which models your key
# can reach and how each scores on the real call transcript.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Anthropic.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Behaviour -------------------------------------------------------------
# "true" forces the deterministic mock phone provider even when a CALL-E key
# is present. Useful for offline demos and for CI.
PROPSTER_DEMO_MODE="false"
# Guard rail: refuse to dial a number that is not on this allowlist.
# Comma-separated E.164 numbers. Empty means "no allowlist" (any seeded
# number may be dialled). Set this before pointing Propster at real agents.
CALLE_PHONE_ALLOWLIST=""

# Optional. E.164 number for the one seeded listing that may be dialled for
# real during a demo. Leave empty and every seeded listing keeps a fictional
# number that cannot be called.
DEMO_AGENT_PHONE=""
